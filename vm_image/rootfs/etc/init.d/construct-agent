#!/sbin/openrc-run
# Agente de construct: atiende el puerto VirtIO-Serial construct-ctl (docs/protocolo.md).

name="construct-agent"
description="Agente del Guest de construct"
command="/usr/local/sbin/construct_daemon"
command_args="${CONSTRUCT_AGENTE_OPCIONES}"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/construct-agent.log"
error_log="/var/log/construct-agent.log"
# Si se cae, vuelve a arrancar: sin agente la VM no sirve.
supervisor="supervise-daemon"
respawn_delay=1

depend() {
	need localmount
	after construct-workspace modules
}

start_pre() {
	# El token llega por fw_cfg: el módulo tiene que estar cargado.
	modprobe -q qemu_fw_cfg 2>/dev/null || true
	modprobe -q virtio_console 2>/dev/null || true
}
